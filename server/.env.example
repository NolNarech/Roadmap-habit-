# Copy this file to .env and fill in your real values. Never commit .env.

# Your MongoDB Atlas connection string (Atlas dashboard → Connect → Drivers).
# Make sure the database user's password has no unescaped @ : / characters,
# and that your current IP is allow-listed under Network Access.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/dev-progress-tracker?retryWrites=true&w=majority

# Port the API server listens on.
PORT=5050

# Where your frontend runs (Vite's default). Only this origin is allowed
# to call the API — update it if you deploy the frontend elsewhere.
CLIENT_ORIGIN=http://localhost:5173

# A shared secret only you know. Sent as a header on every request so a
# stranger who finds your server's URL can't read or overwrite your data.
# Pick any long random string.
APP_SECRET=change-me-to-something-long-and-random
